# See root .env.example for the full documented list. This file mirrors the
# variables the backend process reads directly.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/prepsync
JWT_SECRET=change-me-to-a-long-random-string
GEMINI_API_KEY=
TAVILY_API_KEY=
ALLOW_PRIVATE_HOSTS=false
