# ---- Shared / Backend ----
NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/prepsync

# JWT signing secret for httpOnly auth cookie
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API key (used by packages/core LLM client)
GEMINI_API_KEY=

# Tavily search API key (optional; falls back to DuckDuckGo HTML scrape if unset)
TAVILY_API_KEY=

# When "true", allows the retrieval fetcher/crawler to hit private/loopback/link-local
# hosts. Must remain false/unset in production (SSRF protection).
ALLOW_PRIVATE_HOSTS=false

# ---- Frontend (Next.js) ----
# Base URL the frontend uses to reach the backend API
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Batch CLI (packages/core evaluate script) ----
# Optional override for concurrency when running `npm run evaluate`
EVALUATE_CONCURRENCY=2
